<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="mock-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#mock-bg)" rx="16" />
  
  <!-- Header bar -->
  <rect x="40" y="30" width="1120" height="60" rx="10" fill="#334155" />
  <circle cx="70" cy="60" r="8" fill="#ef4444" />
  <circle cx="95" cy="60" r="8" fill="#f59e0b" />
  <circle cx="120" cy="60" r="8" fill="#10b981" />
  <text x="160" y="66" fill="#f8fafc" font-family="sans-serif" font-size="18" font-weight="bold">ĐỀ ÔN TẬP CHƯƠNG - MA TRẬN BỘ GD&amp;ĐT 2025</text>
  <rect x="960" y="44" width="180" height="32" rx="6" fill="#0284c7" />
  <text x="1050" y="65" fill="#fff" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle">Thời gian: 60:00</text>

  <!-- Left: Content questions -->
  <rect x="40" y="110" width="760" height="520" rx="12" fill="#1e1e2d" stroke="#334155" stroke-width="1.5" />
  <text x="70" y="150" fill="#38bdf8" font-family="sans-serif" font-size="18" font-weight="bold">PHẦN I: 12 CÂU TRẮC NGHIỆM 4 PHƯƠNG ÁN (3.0 ĐIỂM)</text>
  
  <rect x="70" y="180" width="700" height="130" rx="8" fill="#2d3748" />
  <text x="90" y="215" fill="#e2e8f0" font-family="sans-serif" font-size="15" font-weight="600">Câu 1: Cho hàm số y = f(x) có bảng biến thiên như hình vẽ. Điểm cực đại là?</text>
  <rect x="90" y="240" width="140" height="36" rx="6" fill="#3b82f6" />
  <text x="160" y="263" fill="#fff" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle">A. x = 2 (Đúng)</text>
  <rect x="250" y="240" width="140" height="36" rx="6" fill="#4a5568" />
  <text x="320" y="263" fill="#cbd5e1" font-family="sans-serif" font-size="14" text-anchor="middle">B. x = -1</text>
  <rect x="410" y="240" width="140" height="36" rx="6" fill="#4a5568" />
  <text x="480" y="263" fill="#cbd5e1" font-family="sans-serif" font-size="14" text-anchor="middle">C. y = 5</text>
  <rect x="570" y="240" width="140" height="36" rx="6" fill="#4a5568" />
  <text x="640" y="263" fill="#cbd5e1" font-family="sans-serif" font-size="14" text-anchor="middle">D. y = 1</text>

  <text x="70" y="360" fill="#34d399" font-family="sans-serif" font-size="18" font-weight="bold">PHẦN II: 4 CÂU ĐÚNG / SAI (4.0 ĐIỂM - THANG BẬC MỚI)</text>
  <rect x="70" y="390" width="700" height="100" rx="8" fill="#2d3748" />
  <text x="90" y="420" fill="#e2e8f0" font-family="sans-serif" font-size="14">a) [Đúng]  b) [Sai]  c) [Đúng]  d) [Đúng]  =&gt; Đạt 3/4 ý = 0.50 điểm</text>

  <text x="70" y="525" fill="#f43f5e" font-family="sans-serif" font-size="18" font-weight="bold">PHẦN III: 6 CÂU TRẢ LỜI NGẮN (3.0 ĐIỂM)</text>

  <!-- Right: Question grid palette -->
  <rect x="830" y="110" width="330" height="520" rx="12" fill="#1e1e2d" stroke="#334155" stroke-width="1.5" />
  <text x="860" y="150" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="bold">BẢNG ĐIỀU HƯỚNG CÂU HỎI</text>
  
  <!-- 22 buttons mockup -->
  <g transform="translate(860, 180)">
    <rect x="0" y="0" width="42" height="38" rx="6" fill="#10b981" />
      <text x="21" y="24" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">1</text><rect x="54" y="0" width="42" height="38" rx="6" fill="#10b981" />
      <text x="75" y="24" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">2</text><rect x="108" y="0" width="42" height="38" rx="6" fill="#10b981" />
      <text x="129" y="24" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">3</text><rect x="162" y="0" width="42" height="38" rx="6" fill="#10b981" />
      <text x="183" y="24" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">4</text><rect x="216" y="0" width="42" height="38" rx="6" fill="#10b981" />
      <text x="237" y="24" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">5</text><rect x="0" y="50" width="42" height="38" rx="6" fill="#10b981" />
      <text x="21" y="74" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">6</text><rect x="54" y="50" width="42" height="38" rx="6" fill="#10b981" />
      <text x="75" y="74" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">7</text><rect x="108" y="50" width="42" height="38" rx="6" fill="#10b981" />
      <text x="129" y="74" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">8</text><rect x="162" y="50" width="42" height="38" rx="6" fill="#10b981" />
      <text x="183" y="74" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">9</text><rect x="216" y="50" width="42" height="38" rx="6" fill="#10b981" />
      <text x="237" y="74" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">10</text><rect x="0" y="100" width="42" height="38" rx="6" fill="#10b981" />
      <text x="21" y="124" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">11</text><rect x="54" y="100" width="42" height="38" rx="6" fill="#10b981" />
      <text x="75" y="124" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">12</text><rect x="108" y="100" width="42" height="38" rx="6" fill="#10b981" />
      <text x="129" y="124" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">13</text><rect x="162" y="100" width="42" height="38" rx="6" fill="#10b981" />
      <text x="183" y="124" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">14</text><rect x="216" y="100" width="42" height="38" rx="6" fill="#334155" />
      <text x="237" y="124" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">15</text><rect x="0" y="150" width="42" height="38" rx="6" fill="#334155" />
      <text x="21" y="174" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">16</text><rect x="54" y="150" width="42" height="38" rx="6" fill="#334155" />
      <text x="75" y="174" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">17</text><rect x="108" y="150" width="42" height="38" rx="6" fill="#334155" />
      <text x="129" y="174" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">18</text><rect x="162" y="150" width="42" height="38" rx="6" fill="#334155" />
      <text x="183" y="174" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">19</text><rect x="216" y="150" width="42" height="38" rx="6" fill="#334155" />
      <text x="237" y="174" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">20</text><rect x="0" y="200" width="42" height="38" rx="6" fill="#334155" />
      <text x="21" y="224" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">21</text><rect x="54" y="200" width="42" height="38" rx="6" fill="#334155" />
      <text x="75" y="224" fill="#fff" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">22</text>
  </g>

  <rect x="860" y="530" width="270" height="46" rx="8" fill="#10b981" />
  <text x="995" y="559" fill="#fff" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">NỘP BÀI THI</text>
</svg>